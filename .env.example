# ==============================================================================
# VayuGrid (वायुग्रिड) Configuration Environment Template
# Duplicate this file to .env and populate with your credentials.
# ==============================================================================

# --- Google AI & Vertex AI Credentials ---
# Required: Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection (gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Google Cloud Project ID (if leveraging Vertex AI / GEE service accounts)
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=asia-south1
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json

# --- Mapping & Geospatial Services ---
# Required for Google Maps Platform JS & Places APIs
# Ensure Maps JavaScript API, Places API, and Geocoding API are enabled
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- Meteorological & Air Quality Data Sources ---
# Open-Meteo requires no key for open-source tier
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast

# OpenAQ API v3 (Optional: rate limits higher with free API key from https://openaq.org)
OPENAQ_API_KEY=your_openaq_api_key_optional

# --- Server & Networking ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
VITE_BACKEND_URL=http://localhost:8000
ENVIRONMENT=development
LOG_LEVEL=INFO
